# Copy this file to .env and fill in your ElevenLabs API key.

# Required
ELEVENLABS_API_KEY=

# Optional overrides
HOST=127.0.0.1
PORT=9885

# Regional endpoint (default: global)
# ELEVENLABS_API_BASE_URL=https://api.us.elevenlabs.io

# Default models / formats (per-character config can override these)
DEFAULT_MODEL_ID=eleven_flash_v2_5
DEFAULT_OUTPUT_FORMAT=mp3_44100_128
DEFAULT_STREAMING_OUTPUT_FORMAT=pcm_24000
DEFAULT_OPTIMIZE_STREAMING_LATENCY=3

# Paths (defaults are relative to this folder)
# VOICE_CONFIG_DIR=voice_config
# REF_AUDIO_ROOT=ref_audio
# CACHE_FILE=cache/elevenlabs_voices.json

# HTTP_TIMEOUT=120.0
